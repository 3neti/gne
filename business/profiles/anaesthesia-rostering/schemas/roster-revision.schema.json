{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roster Revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["identifier", "roster_period_identifier", "revision_number", "reason", "summary", "validation_status", "validation_snapshot", "changes"],
  "properties": {
    "identifier": {"type": "string", "minLength": 1},
    "roster_period_identifier": {"type": "string", "minLength": 1},
    "revision_number": {"type": "integer", "minimum": 1},
    "reason": {"type": "string", "minLength": 1},
    "summary": {"type": "object"},
    "validation_status": {"enum": ["valid", "valid_with_warnings", "invalid"]},
    "validation_snapshot": {"type": "object"},
    "changes": {"type": "array", "minItems": 1, "items": {"type": "object"}}
  }
}
