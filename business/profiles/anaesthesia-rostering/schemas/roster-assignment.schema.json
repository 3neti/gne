{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roster Assignment",
  "type": "object",
  "additionalProperties": false,
  "required": ["identifier", "doctor_identifier", "roster_period_identifier", "date", "status", "source", "duty_code", "credited_hours"],
  "properties": {
    "identifier": {"type": "string", "minLength": 1},
    "doctor_identifier": {"type": "string", "minLength": 1},
    "roster_period_identifier": {"type": "string", "minLength": 1},
    "date": {"type": "string", "format": "date"},
    "status": {"const": "assigned"},
    "source": {"enum": ["manually_added", "manually_changed", "generated", "imported"]},
    "duty_code": {"const": "standard_day"},
    "start_time": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "end_time": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
    "credited_hours": {"type": "number", "exclusiveMinimum": 0, "maximum": 24},
    "notes": {"type": ["string", "null"]}
  }
}
